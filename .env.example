# PEAAI Frontend Environment Variables
# Copy this file to .env.local for local overrides

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
# The backend origin URL (without /api/v1 - that is added automatically)
# 
# IMPORTANT: Do NOT include /api/v1 in this variable.
# The frontend API client automatically appends /api/v1 to these URLs.
#
# Example URLs constructed from this variable:
#   VITE_API_BASE_URL=https://peaai.onrender.com
#   + /api/v1
#   = https://peaai.onrender.com/api/v1/auth/login

# Local development (backend running on localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Staging/Testing environment
# VITE_API_BASE_URL=https://peaai.onrender.com

# Production environment
# VITE_API_BASE_URL=https://peaai.onrender.com

# =============================================================================
# NOTE: Set VITE_API_BASE_URL in Vercel dashboard for production deployments
# =============================================================================
