# PEAAI Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=PEAAI API
APP_VERSION=1.0.0
DEBUG=false

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:secret@db.example.com:5432/peaai
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/peaai

# =============================================================================
# SECURITY
# =============================================================================
# IMPORTANT: Generate a secure random string for production
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Comma-separated list of allowed origins
# For development: ["*"]
# For production/staging: ["https://your-frontend.vercel.app"]
ALLOWED_ORIGINS=["*"]

# =============================================================================
# WEBSOCKET
# =============================================================================
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_HEARTBEAT_TIMEOUT=60
WEBSOCKET_MAX_MISSED_HEARTBEATS=3

# =============================================================================
# SESSION MANAGEMENT
# =============================================================================
SESSION_MAX_CONCURRENT=5
SESSION_TTL_HOURS=24

# =============================================================================
# STORAGE
# =============================================================================
# CDN base URL (leave empty for local storage)
CDN_BASE_URL=
# Local storage path (WARNING: ephemeral on Render free tier)
STORAGE_PATH=./storage
STORAGE_MAX_IMAGE_SIZE=10485760
STORAGE_MAX_VIDEO_SIZE=104857600
STORAGE_MAX_AUDIO_SIZE=52428800
STORAGE_MAX_DOCUMENT_SIZE=5242880

# =============================================================================
# REDIS (Session Storage)
# =============================================================================
# Format: redis://user:password@host:port/db
# Leave empty to use in-memory session storage (not recommended for production)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# LLM / AI CONFIGURATION (for story generation)
# =============================================================================
# Provider selection: openai, anthropic, ollama, bedrock
LLM_PROVIDER=bedrock

# OpenAI
LLM_API_KEY=your-openai-api-key
OPENAI_ORGANIZATION=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Amazon Bedrock (Nova Micro default)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# Note: AWS credentials should be configured via AWS environment variables
# or ~/.aws/credentials (not in this file)
# export AWS_ACCESS_KEY_ID=your-access-key
# export AWS_SECRET_ACCESS_KEY=your-secret-key
# export AWS_SESSION_TOKEN=your-session-token (if using temporary credentials)

# =============================================================================
# DEBUGGING
# =============================================================================
# Set to "true" to log SQL queries
SQL_ECHO=false
