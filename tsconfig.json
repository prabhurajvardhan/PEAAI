{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["jest", "node"]
  },
  "include": [
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/pages/**/*.ts",
    "src/pages/**/*.tsx",
    "src/foundation/components/**/*.ts",
    "src/foundation/components/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/foundation/components/__tests__/**/*",
    "src/foundation/theme/**/*.ts",
    "src/foundation/theme/**/*.tsx"
  ]
}
